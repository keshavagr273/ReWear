# ==============================================================================
# ReWear — Community Clothing Exchange
# Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and update the values for your local or cloud setup:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (MongoDB Atlas or Local Instance)
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/<database_name>?appName=Cluster0
# For local MongoDB: mongodb://localhost:27017/rewear
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/rewear?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Authentication & Security (JSON Web Token)
# ------------------------------------------------------------------------------
# A cryptographically secure random string used to sign and verify session JWTs.
# Generate one in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_signing_key_change_in_production

# ------------------------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------------------------
# The port number on which the Express REST API server will listen.
PORT=5000

# ------------------------------------------------------------------------------
# 4. Client / CORS Configuration
# ------------------------------------------------------------------------------
# The origin URL of your frontend client (used for CORS and password-reset links).
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. Email Service (Optional - Nodemailer for Password Recovery)
# ------------------------------------------------------------------------------
# Used to dispatch password reset tokens to members.
# Leave blank or set dummy values during local development if not testing emails.
EMAIL_SERVICE=gmail
EMAIL_USER=your_community_email@gmail.com
EMAIL_PASS=your_google_app_specific_password
