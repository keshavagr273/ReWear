# ==============================================================================
# ReWear — Community Clothing Exchange
# Root Environment Configuration Guide
# ==============================================================================
# The ReWear backend expects its environment variables in the 'Backend/.env' file.
# To configure your local development environment:
#
#   1. Copy this template to 'Backend/.env':
#      cp .env.example Backend/.env
#
#   2. Fill in your MongoDB connection details and secrets below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (MongoDB Atlas or Local Instance)
# ------------------------------------------------------------------------------
# Cloud MongoDB Atlas connection string or local mongodb:// URL
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/rewear?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Authentication & Security (JSON Web Token)
# ------------------------------------------------------------------------------
# A secure random secret string used to sign JWT authentication tokens
JWT_SECRET=your_super_secret_jwt_signing_key_change_in_production

# ------------------------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------------------------
# Backend REST API port (default: 5000)
PORT=5000

# ------------------------------------------------------------------------------
# 4. Client / CORS Configuration
# ------------------------------------------------------------------------------
# Frontend client URL for CORS whitelist and password reset email links
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. Email Service (Optional - Nodemailer for Password Recovery)
# ------------------------------------------------------------------------------
# Configure SMTP credentials if testing forgot-password emails
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
